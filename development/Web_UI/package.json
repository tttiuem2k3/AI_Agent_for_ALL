{
	"name": "asoft-ai-services-web-ui",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev:frontend": "pnpm --filter asoft-ai-services-web-frontend dev",
		"dev:backend": "pnpm --filter asoft-ai-services-web-backend dev",
		"dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
		"build:frontend": "pnpm --filter asoft-ai-services-web-frontend build",
		"build:backend": "pnpm --filter asoft-ai-services-web-backend build",
		"build": "pnpm build:frontend && pnpm build:backend",
		"format": "prettier --write . && pnpm --filter asoft-ai-services-web-frontend lint:fix",
		"format:check": "prettier --check . && pnpm --filter asoft-ai-services-web-frontend lint"
	},
	"lint-staged": {
		"frontend/**/*.{ts,tsx}": [
			"prettier --write",
			"cd frontend && pnpm eslint --fix"
		],
		"backend/**/*.{ts,js}": [
			"prettier --write"
		],
		"*.{json,css,md,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"concurrently": "^8.2.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3"
	}
}
